generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

enum CustomerStatus {
  Loyal
  New
  Lost
}

enum OpportunityStatus {
  Pending
  Won
  InProgress
  Lost
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id           String         @id @default(uuid())
  customerNo   String         @unique
  name         String
  email        String
  phone        String?
  region       String
  source       String
  status       CustomerStatus @default(New)
  lastPurchase DateTime       @default(now())
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Opportunity {
  id            String            @id @default(uuid())
  opportunityNo String            @unique
  name          String
  status        OpportunityStatus @default(Pending)
  revenue       Float
  expCloseDate  DateTime
  customerName  String
  ownerName     String
  creationDate  DateTime          @default(now())
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model SalesTeamMember {
  id             String  @id @default(uuid())
  name           String
  avatar         String?
  revenue        Float
  orders         Int
  conversionRate Float
}

model TaskCompletion {
  id          String  @id @default(uuid())
  companyName String
  avatar      String?
  completed   Int
  inProgress  Int
}

model MetricSummary {
  id                   String   @id @default(uuid())
  totalRevenue         Float
  totalRevenueInc      Float
  totalQuantity        Int
  totalQuantityInc     Float
  numberOrders         Int
  numberOrdersInc      Float
  averageOrderValue    Float
  averageOrderValueInc Float
  customerCount        Int
  customerCountInc     Float
  updatedAt            DateTime @updatedAt
}

model MarketingDemographic {
  id         String @id @default(uuid())
  ageGroup   String // e.g. "21-30", "31-40", "41-50"
  percentage Float
  count      Int
}

model ProductPreference {
  id               String @id @default(uuid())
  rank             Int
  productName      String
  purchaseQuantity Int
}

model Client {
  id        String   @id @default(uuid())
  name      String
  industry  String
  region    String
  tier      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id           String   @id @default(uuid())
  ticketNo     String   @unique
  customerName String
  avatar       String?
  subject      String
  category     String
  priority     String   // Urgent, High, Medium, Low
  status       String   // Open, Pending, Resolved
  agentName    String
  createdDate  String
  issueId      String?  @unique
  issue        Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


model Issue {
  id               String   @id @default(uuid())
  issueKey         String   @unique
  title            String
  affectedCustomer String
  status           String   // Open, In Progress, Escalated, Resolved
  assignedAgent    String
  avatar           String?
  slaRemaining     String
  severity         String   // Critical, Major, Minor
  ticket           Ticket?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SolutionArticle {
  id           String   @id @default(uuid())
  title        String
  category     String
  views        Int      @default(0)
  helpfulCount Int      @default(0)
  lastUpdated  String
  summary      String
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CsatReview {
  id           String   @id @default(uuid())
  customerName String
  company      String
  avatar       String?
  rating       Int      @default(5)
  agentName    String
  date         String
  comment      String
  tag          String   // Technical, Billing, Onboarding
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


